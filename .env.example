# Model provider. Set ONE of these keys. With only OPENAI_API_KEY set the backend
# runs on OpenAI; with ANTHROPIC_API_KEY set it runs on Claude. AI_PROVIDER=openai
# or anthropic forces it when both are present. Optional: OPENAI_MODEL_MAIN /
# OPENAI_MODEL_FAST override the gpt-5 / gpt-5-mini defaults.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
TAVILY_API_KEY=
MOCK_AI=1

# Supabase auth (public values, from Project Settings -> API). Leave blank to use the
# browser-only session stub, where any email/password works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXA_API_KEY=
